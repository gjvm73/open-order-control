<slide id="action_queue">
  <background color="bg-base"/>
  <shape id="top-hairline" type="line" x="40" y="42" width="1200" height="0" stroke="accent-red" stroke-width="3"/>
  <text id="slide-num" x="60" y="70" width="180" height="20" font="caption" size="14" color="text-muted">06 / REUNIÃO</text>
  <text id="slide-title" x="60" y="105" width="900" height="46" font="heading" size="36" color="text-main">Fila de Ação para a reunião</text>
  <text id="slide-subtitle" x="60" y="158" width="1060" height="28" font="body" size="18" color="text-muted">Itens com score maior que zero são ordenados por prioridade; os dez primeiros orientam a agenda operacional.</text>
  <shape id="queue-frame" type="rect" x="60" y="218" width="750" height="325" fill="#FFFFFF" stroke="border" stroke-width="1"/>
  <shape id="queue-header" type="rect" x="60" y="218" width="750" height="44" fill="text-main"/>
  <text id="q-h1" x="80" y="232" width="270" height="18" font="caption" size="13" color="#FFFFFF">ITEM / DESCRIÇÃO</text>
  <text id="q-h2" x="468" y="232" width="115" height="18" font="caption" size="13" color="#FFFFFF">SINAL</text>
  <text id="q-h3" x="680" y="232" width="90" height="18" font="caption" size="13" color="#FFFFFF" align="right">SCORE</text>
  <text id="q-row1" x="80" y="286" width="330" height="26" font="body" size="19" color="text-main"><strong>01</strong>  Item com maior desvio</text>
  <text id="q-row1s" x="468" y="286" width="160" height="26" font="body" size="18" color="accent-red">Vencido • Alterado</text>
  <text id="q-row1v" x="680" y="286" width="90" height="26" font="metric" size="26" color="accent-red" align="right">CRÍTICO</text>
  <shape id="q-line1" type="line" x="80" y="325" width="690" height="0" stroke="border" stroke-width="1"/>
  <text id="q-row2" x="80" y="346" width="330" height="26" font="body" size="19" color="text-main"><strong>02</strong>  Item sem fornecedor</text>
  <text id="q-row2s" x="468" y="346" width="160" height="26" font="body" size="18" color="accent-red">Fornecedor ausente</text>
  <text id="q-row2v" x="680" y="346" width="90" height="26" font="metric" size="24" color="text-main" align="right">ATENÇÃO</text>
  <shape id="q-line2" type="line" x="80" y="385" width="690" height="0" stroke="border" stroke-width="1"/>
  <text id="q-row3" x="80" y="406" width="330" height="26" font="body" size="19" color="text-main"><strong>03</strong>  Item de prioridade alta</text>
  <text id="q-row3s" x="468" y="406" width="160" height="26" font="body" size="18" color="text-main">Prioridade alta</text>
  <text id="q-row3v" x="680" y="406" width="90" height="26" font="metric" size="24" color="text-main" align="right">MONITORAR</text>
  <text id="queue-foot" x="80" y="482" width="680" height="34" font="caption" size="14" color="text-muted">Empate: prevalece o item com maior número acumulado de alterações de previsão.</text>
  <shape id="logic-panel" type="rect" x="840" y="218" width="380" height="325" fill="surface" stroke="border" stroke-width="1"/>
  <text id="logic-label" x="864" y="240" width="240" height="20" font="caption" size="14" color="accent-red">COMO O SCORE É CALCULADO</text>
  <text id="logic-1" x="864" y="281" width="315" height="25" font="body" size="19" color="text-main"><strong>4 pts</strong> por alteração</text>
  <text id="logic-2" x="864" y="323" width="315" height="25" font="body" size="19" color="text-main"><strong>+5 pts</strong> sem fornecedor</text>
  <text id="logic-3" x="864" y="365" width="315" height="25" font="body" size="19" color="text-main"><strong>+3 pts</strong> previsão vencida</text>
  <text id="logic-4" x="864" y="407" width="315" height="25" font="body" size="19" color="text-main"><strong>+2 pts</strong> prioridade alta</text>
  <text id="logic-note" x="864" y="466" width="310" height="38" font="caption" size="14" color="text-muted">Pesos podem ser atualizados pelo administrador nas Configurações.</text>
  <shape id="class-band" type="rect" x="60" y="578" width="1160" height="55" fill="text-main"/>
  <text id="class-critical" x="125" y="596" width="220" height="22" font="body" size="18" color="accent-red"><strong>CRÍTICO</strong>  ≥ 8 pontos</text>
  <text id="class-attention" x="510" y="596" width="260" height="22" font="body" size="18" color="#FFFFFF"><strong>ATENÇÃO</strong>  4–7 pontos</text>
  <text id="class-monitor" x="880" y="596" width="260" height="22" font="body" size="18" color="#FFFFFF"><strong>MONITORAR</strong>  1–3 pontos</text>
  <text id="page" x="1190" y="674" width="50" height="18" font="caption" size="14" color="text-muted" align="right">07</text>
</slide>
